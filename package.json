{
  "name": "job-aggregator-v1",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "db:catalog:push": "drizzle-kit push --config=drizzle.catalog.config.ts",
    "db:user:push": "drizzle-kit push --config=drizzle.user.config.ts",
    "aggregate": "tsx src/aggregation/cli.ts",
    "catalog:validate": "tsx src/aggregation/validateCli.ts",
    "catalog:manifest": "tsx src/aggregation/manifestCli.ts",
    "catalog:verify-manifest": "tsx src/aggregation/verifyManifestCli.ts",
    "jobs:next": "tsx scripts/jobs-next.ts",
    "application:result": "tsx scripts/application-result.ts",
    "application:retry": "tsx scripts/application-retry.ts",
    "candidate:import": "tsx scripts/candidate-import.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "drizzle-orm": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
